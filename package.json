{
  "name": "link-to-notion-db",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter web --filter server --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter web --filter server build",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "start": "pnpm --filter web start",
    "lint": "eslint",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook",
    "typecheck": "pnpm --filter web --filter server typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:server": "pnpm --filter server typecheck",
    "test": "pnpm --filter web --filter server test",
    "test:web": "pnpm --filter web test",
    "test:server": "pnpm --filter server test",
    "test:storybook": "pnpm --filter web test:storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.6.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
