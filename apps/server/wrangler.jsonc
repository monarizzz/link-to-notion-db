{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "routes": [{ "pattern": "work.monelog.me/api/*", "zone_name": "monelog.me" }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worklog",
      "database_id": "8f00ae7f-8c48-49ef-b6fb-7acee0faf89c",
      // ローカル（wrangler dev・--local）はこの ID でデータを保存する。本番の ID に変える前と同じ保存先を使う
      "preview_database_id": "local",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // wrangler preview（Workers Builds のプレビュー）はこの項目が無いと失敗する。ダッシュボードのプレビューの設定と揃える
  "previews": {
    "observability": {
      "enabled": false,
      "head_sampling_rate": 1,
      "issues": {
        "enabled": false,
      },
      "logs": {
        "enabled": false,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true,
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true,
      },
    },
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
}
