{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // 認証（Cloudflare Access）を設定するまで、*.workers.dev で公開しない
  "workers_dev": false,
  "preview_urls": false,
  // API（apps/server）は公開 URL を持たないため、Service Binding で呼ぶ
  "services": [{ "binding": "API", "service": "server" }],
}
