{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 3000",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project node --passWithNoTests",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@opennextjs/cloudflare": "1.20.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "hono": "^4.13.19",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-onboarding": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/nextjs-vite": "^10.6.8",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "playwright": "^1.65.1",
    "server": "workspace:*",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1",
    "wrangler": "4.165.0"
  }
}
