# Notion の内部インテグレーションシークレット
NOTION_TOKEN=
# レコードの作成に使う Database ID
DATABASE_ID=
# レコードの取得に使う Data source ID
DATA_SOURCE_ID=

# Google ログイン（OAuth クライアント）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3000
# `openssl rand -base64 32` などで生成する
NEXTAUTH_SECRET=

# ログインを許可する Google アカウント（カンマ区切り）。未設定の場合は誰もログインできません
ALLOWED_EMAILS=you@example.com,other@example.com

# API（apps/server）の URL。ローカルでは `pnpm --filter server dev` で起動する
API_BASE_URL=http://localhost:8787
