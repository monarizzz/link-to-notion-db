{
  "permissions": {
    "allow": [
      "Read",
      "Bash(ls*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.development*)",
      "Bash(cat .env.production*)",
      "Bash(cat .env.test*)",
      "Bash(head *.env)",
      "Bash(head *.env.local)",
      "Bash(head *.env.development*)",
      "Bash(head *.env.production*)",
      "Bash(head *.env.test*)",
      "Bash(tail *.env)",
      "Bash(tail *.env.local)",
      "Bash(tail *.env.development*)",
      "Bash(tail *.env.production*)",
      "Bash(tail *.env.test*)",
      "Bash(less *.env)",
      "Bash(less *.env.local)",
      "Bash(less *.env.development*)",
      "Bash(less *.env.production*)",
      "Bash(less *.env.test*)",
      "Bash(source .env)",
      "Bash(source .env.local)",
      "Bash(source .env.development*)",
      "Bash(source .env.production*)",
      "Bash(source .env.test*)",
      "Bash(grep * .env)",
      "Bash(grep * .env.local)",
      "Bash(grep * .env.development*)",
      "Bash(grep * .env.production*)",
      "Bash(grep * .env.test*)"
    ]
  }
}
